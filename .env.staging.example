# Vercel pilot: genuine accounts and Paystack TEST transactions. No fake seed data.
APP_ENV=staging
PAYMENT_MODE=paystack_test
APP_URL=https://YOUR-PROJECT.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/freshfold_staging?sslmode=require
DATABASE_ENVIRONMENT_TAG=staging
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
WHATSAPP_NUMBER=233551234987
COMPANY_EMAIL=admin@freshfold.test
# One trusted Vercel proxy hop. Do not expose a second origin outside Vercel.
TRUST_PROXY_HOPS=1
NODEJS_HELPERS=0
# Generate unique random values of at least 32 characters privately.
CRON_SECRET=
FILE_LINK_SECRET=
# Private S3-compatible bucket (for example an existing AWS S3 or R2 bucket).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional authenticated HTTPS malware scanner for PDFs.
# JPEG/PNG verification documents are decoded and safely re-encoded directly.
FILE_SCANNER_URL=
FILE_SCANNER_TOKEN=
# Optional dedicated private ClamAV daemon instead of the HTTPS scanner.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# Optional override for internal Paystack test receipts only. Real accounts use their own email.
# Use a deliverable company-owned receipt email; Paystack rejects .test addresses.
# PAYSTACK_TEST_EMAIL=
# Provisioning: apply these values privately, then run npm run check:pilot,
# npm run db:deploy, and npm run admin:create on the staging database.
# ADMIN_EMAIL=admin@freshfold.test
# ADMIN_NAME=Fresh Fold
# ADMIN_PASSWORD= (unique, at least 16 characters; remove after initial setup)
# Paystack webhook: https://YOUR-PROJECT.vercel.app/api/webhooks/paystack
# Schedule GET /api/maintenance once per minute with
# Authorization: Bearer CRON_SECRET, using a scheduler that supports that interval.
# The included daily Vercel cron is a fallback; active requests also process jobs.
