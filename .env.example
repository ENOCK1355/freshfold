# Demo uses real, persisted embedded PostgreSQL; no external account needed.
APP_ENV=demo
PAYMENT_MODE=paystack_test
DATABASE_DIR=.data/demo/postgres
DEMO_DATA_ROOT=.data/demo
APP_URL=http://localhost:5173
PORT=4000
WHATSAPP_NUMBER=233551234987
COMPANY_EMAIL=admin@freshfold.test
# External PostgreSQL for staging/production (never point demo at production).
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/freshfold_demo
# DATABASE_ENVIRONMENT_TAG=demo
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# Webhooks use PAYSTACK_SECRET_KEY, with no separate signing secret.
# Use a deliverable company-owned receipt email; Paystack rejects .test addresses.
# PAYSTACK_TEST_EMAIL=
# PAYSTACK_SUBACCOUNT_CODE=
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# CLAMAV_HOST=
