{
  "name": "fresh-fold",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run dev -w @freshfold/api\" \"npm run dev -w @freshfold/web\"",
    "build": "npm run db:generate && npm run typecheck && npm run build -w @freshfold/web && tsx scripts/build-api.ts",
    "start": "node dist/api/main.js",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint apps packages scripts tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:deploy": "prisma migrate deploy",
    "admin:create": "tsx scripts/database.ts admin",
    "check:production": "tsx scripts/check-production.ts",
    "check:pilot": "tsx scripts/check-production.ts --pilot",
    "demo:setup": "npm run db:generate && tsx scripts/database.ts setup",
    "demo:seed": "tsx scripts/database.ts seed",
    "demo:reset": "tsx scripts/database.ts reset",
    "demo:verify": "vitest run tests/integration.test.ts",
    "worker": "tsx apps/api/src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.930.0",
    "@aws-sdk/s3-request-presigner": "^3.930.0",
    "@electric-sql/pglite": "^0.6.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@hookform/resolvers": "^5.2.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.90.0",
    "@vercel/functions": "^3.11.4",
    "bullmq": "^5.63.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.554.0",
    "motion": "^12.23.0",
    "pglite-prisma-adapter": "0.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
