# Copy to .env.production and supply values through your host's secret manager.
APP_ENV=production
PAYMENT_MODE=paystack_live
APP_URL=
PORT=4000
HOST=0.0.0.0
TRUST_PROXY_HOPS=1
NODEJS_HELPERS=0
CRON_SECRET=
FILE_LINK_SECRET=
DATABASE_URL=
DATABASE_ENVIRONMENT_TAG=production
WHATSAPP_NUMBER=233551234987
COMPANY_EMAIL=admin@freshfold.test
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack uses PAYSTACK_SECRET_KEY to sign x-paystack-signature.
# Optional for a separately hosted background worker.
REDIS_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# PDFs require an authenticated HTTPS scanner; JPEG/PNG documents work directly.
FILE_SCANNER_URL=
FILE_SCANNER_TOKEN=
